generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Question {
  id          String     @id @default(cuid())
  text        String
  choices     String[]
  answerIndex Int
  explanation String
  period      Period
  difficulty  Difficulty
  createdAt   DateTime   @default(now())
}

model Game {
  id                   String     @id @default(cuid())
  code                 String     @unique
  hostId               String
  status               GameStatus @default(LOBBY)
  difficulty           Difficulty
  speedBonus           Boolean    @default(true)
  totalQuestions       Int        @default(10)
  currentQuestionIndex Int        @default(0)
  players              Player[]
  rounds               Round[]
  createdAt            DateTime   @default(now())
}

model Player {
  id       String   @id @default(cuid())
  nickname String
  score    Int      @default(0)
  socketId String?
  gameId   String
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers  Answer[]
}

model Round {
  id         String    @id @default(cuid())
  gameId     String
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  questionId String
  orderIndex Int
  startedAt  DateTime?
  answers    Answer[]
}

model Answer {
  id             String   @id @default(cuid())
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  roundId        String
  round          Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  choiceIndex    Int
  isCorrect      Boolean
  pointsEarned   Int
  answeredAt     DateTime @default(now())
  responseTimeMs Int
}

enum Period {
  ANTIQUITE_GAULE
  MOYEN_AGE
  RENAISSANCE_ANCIEN_REGIME
  REVOLUTION_EMPIRE
  XIXE_SIECLE
  GUERRES_MONDIALES
  GUERRE_FROIDE_DECOLONISATION
  EPOQUE_CONTEMPORAINE
}

enum Difficulty {
  FACILE
  MOYEN
  DIFFICILE
}

enum GameStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
}
