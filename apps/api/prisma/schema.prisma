generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  pseudo        String        @unique
  email         String        @unique
  avatarUrl     String?
  emailVerified Boolean       @default(false)
  oauthProvider String?
  oauthId       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  players       Player[]
  weeklyScores  WeeklyScore[]
  weeklyBadges  WeeklyBadge[]
}

model Question {
  id          String     @id @default(cuid())
  text        String     @unique
  choices     String[]
  answerIndex Int
  explanation String
  period      Period
  difficulty  Difficulty
  topic       Topic      @default(HISTOIRE)
  createdAt   DateTime   @default(now())
}

model Game {
  id                   String     @id @default(cuid())
  code                 String     @unique
  hostId               String
  status               GameStatus @default(LOBBY)
  difficulty           Difficulty
  topics               Topic[]              @default([])
  gameMode             GameMode   @default(STANDARD)
  speedBonus           Boolean    @default(true)
  doublePointsBonus    Boolean    @default(false)
  totalQuestions       Int        @default(10)
  questionDuration     Int        @default(10)
  currentQuestionIndex Int        @default(0)
  players              Player[]
  rounds               Round[]
  createdAt            DateTime   @default(now())
}

model Player {
  id         String   @id @default(cuid())
  nickname   String
  score      Int      @default(0)
  socketId   String?
  lives      Int      @default(3)
  eliminated Boolean  @default(false)
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers    Answer[]
}

model Round {
  id         String    @id @default(cuid())
  gameId     String
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  questionId String
  orderIndex Int
  startedAt  DateTime?
  answers    Answer[]
}

model Answer {
  id             String   @id @default(cuid())
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  roundId        String
  round          Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  choiceIndex    Int
  isCorrect      Boolean
  pointsEarned   Int
  answeredAt     DateTime @default(now())
  responseTimeMs Int
}

enum Period {
  ANTIQUITE_GAULE
  MOYEN_AGE
  RENAISSANCE_ANCIEN_REGIME
  REVOLUTION_EMPIRE
  XIXE_SIECLE
  GUERRES_MONDIALES
  GUERRE_FROIDE_DECOLONISATION
  EPOQUE_CONTEMPORAINE
}

enum Difficulty {
  FACILE
  MOYEN
  DIFFICILE
  VARIE
}

enum GameMode {
  STANDARD
  SURVIVAL_SOLO
  SURVIVAL_MULTI
}

enum GameStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model WeeklyScore {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart        DateTime
  points           Int       @default(0)
  quizzesPlayed    Int       @default(0)
  answerStreak     Int       @default(0)
  connectionStreak Int       @default(0)
  lastConnectedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, weekStart])
}

model WeeklyBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  tier      Tier
  points    Int
  rank      Int?
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

enum Topic {
  HISTOIRE
  GEOGRAPHIE
  GEOPOLITIQUE
  CINEMA
  PHILOSOPHIE
  LITTERATURE
}
